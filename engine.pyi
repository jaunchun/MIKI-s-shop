"""Type stub for the C++ `engine` module: the contract between engine and game code."""
from typing import Tuple

Vec3 = Tuple[float, float, float]

class Input:
    def key_down(self, key: int) -> bool: ...
    def key_pressed(self, key: int) -> bool: ...
    def key_released(self, key: int) -> bool: ...
    def mouse_down(self, button: int) -> bool: ...
    def mouse_pressed(self, button: int) -> bool: ...
    def mouse_pos(self) -> Tuple[float, float]: ...
    def mouse_delta(self) -> Tuple[float, float]: ...
    def scroll(self) -> float: ...
    def set_cursor_locked(self, locked: bool) -> None: ...
    @property
    def cursor_locked(self) -> bool: ...

class Renderer:
    def load_mesh(self, name_or_path: str) -> int: ...          # "cube", "plane" or .obj path
    def create_object(self, mesh: int, color: Vec3 = ...) -> int: ...
    def destroy_object(self, obj: int) -> None: ...
    def set_transform(self, obj: int, pos: Vec3, rot: Vec3, scale: Vec3) -> None: ...  # rot in degrees
    def set_color(self, obj: int, color: Vec3) -> None: ...
    def set_visible(self, obj: int, visible: bool) -> None: ...
    def set_camera(self, pos: Vec3, yaw: float, pitch: float) -> None: ...  # degrees
    def set_flashlight(self, on: bool) -> None: ...
    def set_fog(self, color: Vec3, density: float) -> None: ...
    def set_ambient(self, color: Vec3) -> None: ...

class Application:
    def __init__(self, width: int, height: int, title: str) -> None: ...
    def running(self) -> bool: ...
    def quit(self) -> None: ...
    def begin_frame(self) -> float: ...
    def end_frame(self) -> None: ...
    @property
    def input(self) -> Input: ...
    @property
    def renderer(self) -> Renderer: ...

KEY_W: int; KEY_A: int; KEY_S: int; KEY_D: int; KEY_E: int; KEY_F: int
KEY_TAB: int; KEY_CTRL: int; KEY_SPACE: int; KEY_SHIFT: int; KEY_ESC: int
KEY_1: int; KEY_2: int; KEY_3: int; KEY_4: int
M_LEFT: int; M_RIGHT: int
